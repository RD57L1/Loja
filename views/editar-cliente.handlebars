<div class="page-head">
    <span class="eyebrow">Relacionamento</span>
    <h2>Editar Cliente</h2>
    <p>Atualize os dados de <strong>{{cliente.nome}}</strong>.</p>
</div>

{{#if erro}}
    <p class="alert alert-erro">{{erro}}</p>
{{/if}}

<div class="resumo-box" style="margin-bottom: 20px;">
    <span><span class="stat-label">Limite de crédito</span><span class="stat-value">{{formatMoney cliente.limite_credito}}</span></span>
    <span><span class="stat-label">Saldo devedor atual</span><span class="stat-value">{{formatMoney cliente.saldo_devedor}}</span></span>
</div>

<form action="/clientes/editar/{{cliente.id}}" method="POST" class="form-cadastro card-form">
    <div class="form-group">
        <label for="nome">Nome completo</label>
        <input type="text" id="nome" name="nome" value="{{cliente.nome}}" required>
    </div>
    <div class="form-group">
        <label for="telefone">Telefone</label>
        <input type="text" id="telefone" name="telefone" value="{{cliente.telefone}}" placeholder="(00) 00000-0000">
    </div>
    <div class="form-group">
        <label for="cpf">CPF (apenas números)</label>
        <input type="text" id="cpf" name="cpf" maxlength="11" value="{{cliente.cpf}}" placeholder="Somente números">
    </div>
    <div class="form-group">
        <label for="limite_credito">Limite de crédito para compras fiado (R$)</label>
        <input type="number" step="0.01" min="0" id="limite_credito" name="limite_credito" value="{{cliente.limite_credito}}">
    </div>
    <div style="display: flex; gap: 10px;">
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        <a href="/clientes" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
