<div class="page-head">
    <span class="eyebrow">Gerência</span>
    <h2>Editar Despesa</h2>
    <p>Corrija os dados de um lançamento do fluxo de caixa.</p>
</div>

{{#if erro}}
    <p class="alert alert-erro">{{erro}}</p>
{{/if}}

<form action="/fluxo-caixa/despesa/editar/{{despesa.id}}" method="POST" class="form-cadastro card-form">
    <div class="form-group">
        <label for="descricao">Descrição detalhada</label>
        <input type="text" id="descricao" name="descricao" value="{{despesa.descricao}}" required>
    </div>
    <div class="form-group">
        <label for="categoria">Categoria</label>
        <input type="text" id="categoria" name="categoria" value="{{despesa.categoria}}" required>
    </div>
    <div class="form-group">
        <label for="valor">Valor pago (R$)</label>
        <input type="number" step="0.01" min="0.01" id="valor" name="valor" value="{{despesa.valor}}" required>
    </div>
    <div style="display: flex; gap: 10px;">
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        <a href="/fluxo-caixa" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
