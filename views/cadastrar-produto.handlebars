<div class="page-head">
    <span class="eyebrow">Estoque</span>
    <h2>Cadastrar Novo Produto</h2>
    <p>Registre uma peça nova. O código é gerado automaticamente.</p>
</div>

{{#if sucesso}}
    <p class="alert alert-sucesso">{{sucesso}}</p>
{{/if}}
{{#if erro}}
    <p class="alert alert-erro">{{erro}}</p>
{{/if}}

<form action="/cadastrar-produto" method="POST" class="form-cadastro card-form">
    <div class="form-group">
        <label>Código do produto</label>
        <p class="codigo-auto">Gerado <strong>automaticamente</strong> ao cadastrar (5 dígitos).</p>
    </div>
    <div class="form-group">
        <label for="descricao">Descrição</label>
        <input type="text" id="descricao" name="descricao" required>
    </div>
    <div class="form-group">
        <label for="tipo">Tipo</label>
        <input type="text" id="tipo" name="tipo" required>
    </div>
    <div class="form-group">
        <label for="custo">Custo (R$)</label>
        <input type="number" step="0.01" id="custo" name="custo" required>
    </div>
    <div class="form-group">
        <label for="valor">Valor de venda (R$)</label>
        <input type="number" step="0.01" id="valor" name="valor" required>
    </div>
    <div class="form-group">
        <label for="cor">Cor</label>
        <input type="text" id="cor" name="cor" placeholder="Ex: Preto, Off White...">
    </div>
    <div class="form-group">
        <label for="tamanho">Tamanho</label>
        <input type="text" id="tamanho" name="tamanho" placeholder="Ex: P, M, G, 38, 40...">
    </div>
    <div class="form-group">
        <label for="quantidade">Quantidade em estoque</label>
        <input type="number" min="0" step="1" id="quantidade" name="quantidade" value="1" required>
    </div>
    <div class="form-group">
        <label for="data_aquisicao">Data de aquisição</label>
        <input type="date" id="data_aquisicao" name="data_aquisicao" required>
    </div>
    <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="disponivel">Disponível</option>
            <option value="vendido">Vendido</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar Produto</button>
</form>