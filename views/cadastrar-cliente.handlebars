<div class="page-head">
    <span class="eyebrow">Relacionamento</span>
    <h2>Cadastrar Novo Cliente</h2>
    <p>Cadastre clientes para permitir compras fiado (a prazo).</p>
</div>

{{#if sucesso}}
    <p class="alert alert-sucesso">{{sucesso}}</p>
{{/if}}
{{#if erro}}
    <p class="alert alert-erro">{{erro}}</p>
{{/if}}

<form action="/clientes/cadastrar" method="POST" class="form-cadastro card-form">
    <div class="form-group">
        <label for="nome">Nome completo</label>
        <input type="text" id="nome" name="nome" required>
    </div>
    <div class="form-group">
        <label for="telefone">Telefone</label>
        <input type="text" id="telefone" name="telefone" placeholder="(00) 00000-0000">
    </div>
    <div class="form-group">
        <label for="cpf">CPF</label>
        <input type="text" id="cpf" name="cpf" maxlength="14" placeholder="000.000.000-00" required>
    </div>
    <div class="form-group">
        <label for="limite_credito">Limite de crédito para compras fiado (R$)</label>
        <input type="number" step="0.01" min="0" id="limite_credito" name="limite_credito" value="0">
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar Cliente</button>
</form>

<!-- SCRIPT DE MÁSCARA PARA O CPF E LIMPEZA DO CAMPO DE LIMITE -->
<script>
document.getElementById('cpf').addEventListener('input', function (e) {
    let value = e.target.value.replace(/\D/g, ''); // Remove tudo que não for número
    if (value.length > 11) value = value.slice(0, 11); // Limita a 11 dígitos

    // Aplica a formatação 000.000.000-00 automaticamente
    if (value.length > 9) {
        value = value.replace(/^(\d{3})(\d{3})(\d{3})(\d{2}).*/, '$1.$2.$3-$4');
    } else if (value.length > 6) {
        value = value.replace(/^(\d{3})(\d{3})(\d{1,3}).*/, '$1.$2.$3');
    } else if (value.length > 3) {
        value = value.replace(/^(\d{3})(\d{1,3}).*/, '$1.$2');
    }
    
    e.target.value = value;
});

// Comportamento inteligente para o campo de Limite de Crédito (limpa o 0 ao focar)
const inputLimite = document.getElementById('limite_credito');
inputLimite.addEventListener('focus', function() {
    this.select();
    if (this.value === '0' || this.value === '0.00') {
        this.value = '';
    }
});
inputLimite.addEventListener('blur', function() {
    if (this.value === '') {
        this.value = '0';
    }
});
</script>